# Production values — copy to your host's env settings (do NOT commit real secrets).
# Works as-is for self-hosting (Coolify/docker compose). For Vercel, see DEPLOY.md.

## Self-host (docker compose / Coolify)
PORT=5000
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/db?sslmode=require
APP_BASE_URL=https://lynk.example.com
APP_SECRET=PASTE_64_HEX_FROM_openssl_rand_hex_32
CORS_ORIGINS=lynk.example.com
VITE_API_BASE_URL=/api
VITE_APP_BASE_URL=https://lynk.example.com
# Nodryx SSO — secret is server-side only (never a VITE_ var, never in the bundle).
# Register https://lynk.example.com/api/auth/callback/nodryx as the client's
# redirect URI in Nodryx, exactly per character.
NODRYX_AUTH_URL=https://auth.nodryx.example.com
NODRYX_CLIENT_ID=
NODRYX_CLIENT_SECRET=
# Optional: Google Safe Browsing key to block malware/phishing destinations
SAFE_BROWSING_API_KEY=
# APP_URL=https://lynk.example.com
# Traefik: uncomment labels in docker-compose.yml and remove ports when deploying on Coolify.
# Frontend must be rebuilt after changing VITE_* (build-time args).
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_PER_DAY=50
USER_RATE_LIMIT_PER_MIN=20
USER_RATE_LIMIT_PER_DAY=500

## Vercel (serverless) — set these instead of the self-host block above:
# DATABASE_URL=postgresql://...@ep-xxx-pooler.neon.tech/db?sslmode=require   (pooled host, -pooler)
# APP_BASE_URL=https://your-app.vercel.app
# APP_SECRET=PASTE_64_HEX_FROM_openssl_rand_hex_32
# VITE_API_BASE_URL=/api
# VITE_APP_BASE_URL=https://your-app.vercel.app
# NODRYX_AUTH_URL=https://auth.nodryx.example.com
# NODRYX_CLIENT_ID=...
# NODRYX_CLIENT_SECRET=...   (server-side only)
# APP_URL=https://your-app.vercel.app
# TRUST_PROXY=1
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# DB_MAX_CONNS=3
