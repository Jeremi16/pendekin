PORT=5000
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/db?sslmode=require
APP_BASE_URL=http://localhost:5173
APP_SECRET=change_me_to_32_plus_hex_chars_generated_by_openssl_rand_hex_32
CORS_ORIGINS=localhost:5173,localhost:5000
# Nodryx SSO (OAuth2 authorization code + PKCE S256). Login is enabled when all
# three are set. The secret is server-side only — NEVER expose it to the browser
# (no VITE_ prefix, never send to the client).
# Register the redirect URI EXACTLY as below in the Nodryx client settings, plus
# the app origins (localhost:5173 for dev, your domain for production).
NODRYX_AUTH_URL=https://auth.nodryx.example.com
NODRYX_CLIENT_ID=
NODRYX_CLIENT_SECRET=
# Optional: Google Safe Browsing key to block malware/phishing destinations
SAFE_BROWSING_API_KEY=
# Redirect URI (must match the Nodryx client registration per character):
#   http://localhost:5173/api/auth/callback/nodryx          (dev)
#   https://<your-domain>/api/auth/callback/nodryx          (production)
# APP_URL is the public origin used to build that redirect URI; APP_BASE_URL is
# kept as a fallback for existing deployments.
# APP_URL=http://localhost:5173
# Frontend (build-time)
VITE_API_BASE_URL=/api
VITE_APP_BASE_URL=http://localhost:5173
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_PER_DAY=50
USER_RATE_LIMIT_PER_MIN=20
USER_RATE_LIMIT_PER_DAY=500
# Serverless (Vercel) only — leave unset for self-hosting:
# TRUST_PROXY=1
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# DB_MAX_CONNS=3
